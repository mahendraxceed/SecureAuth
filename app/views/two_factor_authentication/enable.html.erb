<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-indigo-600 text-white mb-3">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900">Enable Two-Factor Authentication</h1>
      <p class="mt-1 text-sm text-gray-600">Secure your account with an extra layer of protection</p>
    </div>

    <!-- Main Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden">
      <div class="p-6">
        <!-- Step Indicator -->
        <div class="flex items-center justify-center mb-6">
          <div class="flex items-center">
            <div class="flex items-center justify-center h-8 w-8 rounded-full bg-indigo-600 text-white text-sm font-semibold">1</div>
            <div class="w-12 h-1 bg-indigo-600 mx-2"></div>
            <div class="flex items-center justify-center h-8 w-8 rounded-full bg-indigo-600 text-white text-sm font-semibold">2</div>
            <div class="w-12 h-1 bg-gray-300 mx-2"></div>
            <div class="flex items-center justify-center h-8 w-8 rounded-full bg-gray-300 text-gray-600 text-sm font-semibold">3</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Left Side - Instructions -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Setup Instructions</h2>

            <div class="space-y-6">
              <!-- Step 1 -->
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 font-semibold">
                    1
                  </div>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-semibold text-gray-900">Download an Authenticator App</h3>
                  <p class="mt-2 text-gray-600">
                    Install a TOTP authenticator app on your mobile device. We recommend:
                  </p>
                  <ul class="mt-2 space-y-1 text-sm text-gray-600">
                    <li class="flex items-center">
                      <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      Google Authenticator
                    </li>
                    <li class="flex items-center">
                      <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      Authy
                    </li>
                    <li class="flex items-center">
                      <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      Microsoft Authenticator
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 font-semibold">
                    2
                  </div>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-semibold text-gray-900">Scan the QR Code</h3>
                  <p class="mt-2 text-gray-600">
                    Open your authenticator app and scan the QR code shown on the right.
                  </p>
                  <div class="mt-3 p-3 bg-blue-50 rounded-lg border border-blue-200">
                    <p class="text-sm text-blue-800">
                      <span class="font-semibold">Can't scan?</span> Manually enter this key in your app:
                    </p>
                    <code class="block mt-2 p-2 bg-white rounded text-xs font-mono text-gray-800 break-all">
                      <%= @otp_secret %>
                    </code>
                  </div>
                </div>
              </div>

              <!-- Step 3 -->
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 font-semibold">
                    3
                  </div>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-semibold text-gray-900">Verify the Code</h3>
                  <p class="mt-2 text-gray-600">
                    Enter the 6-digit verification code from your authenticator app below to complete setup.
                  </p>
                </div>
              </div>
              <!-- Security Notice -->
              <div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-4 w-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-2">
                    <h3 class="text-xs font-medium text-yellow-800">Important</h3>
                    <p class="mt-1 text-xs text-yellow-700">
                      Keep this QR code private.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Side - QR Code & Verification -->
          <div class="flex flex-col space-y-4">
            <!-- QR Code Card -->
            <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-6 shadow-lg">
              <div class="bg-white p-5 rounded-lg shadow-md">
                <h3 class="text-center font-semibold text-gray-900 mb-3">Scan this QR Code</h3>
                <div class="flex justify-center">
                  <%= @qr_code.as_svg(
                    offset: 0,
                    color: '000',
                    shape_rendering: 'crispEdges',
                    module_size: 5,
                    standalone: true,
                    use_path: true
                  ).html_safe %>
                </div>
                <p class="mt-3 text-center text-xs text-gray-600">
                  SecureAuth - <%= current_user.email || current_user.mobile_no %>
                </p>
              </div>
            </div>

            <!-- Verification Form -->
            <div class="bg-white rounded-xl p-5 shadow-lg border-2 border-indigo-100">
              <h3 class="font-semibold text-gray-900 mb-3 text-center">Enter Verification Code</h3>

              <%= form_with url: confirm_two_factor_authentication_path, method: :post, data: { turbo: false } do |f| %>
                <div class="flex flex-col items-center">
                  <div class="w-full">
                    <label for="otp_code" class="block text-xs font-medium text-gray-700 mb-2 text-center">
                      6-Digit Code from Authenticator App
                    </label>
                    <%= f.text_field :otp_code,
                        placeholder: "000000",
                        maxlength: "6",
                        pattern: "[0-9]{6}",
                        required: true,
                        autofocus: true,
                        class: "appearance-none block w-full px-4 py-2.5 text-center text-xl font-mono tracking-widest border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition duration-150" %>
                  </div>

                  <div class="mt-4 w-full flex gap-3">
                    <%= link_to "Cancel", root_path,
                        class: "flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2.5 px-4 rounded-lg text-center text-sm transition duration-150" %>
                    <%= f.submit "Verify & Enable 2FA",
                        class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-lg text-sm transition duration-150 cursor-pointer" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Help Section -->
    <div class="mt-8 bg-white rounded-xl shadow-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Need Help?</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start">
          <svg class="h-6 w-6 text-indigo-600 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h4 class="font-semibold text-gray-900">Lost your device?</h4>
            <p class="text-sm text-gray-600 mt-1">After setup, you'll receive backup codes that can be used if you lose access to your authenticator app.</p>
          </div>
        </div>
        <div class="flex items-start">
          <svg class="h-6 w-6 text-indigo-600 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h4 class="font-semibold text-gray-900">Code not working?</h4>
            <p class="text-sm text-gray-600 mt-1">Make sure your device's time is set correctly. TOTP codes are time-sensitive and require accurate device time.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
