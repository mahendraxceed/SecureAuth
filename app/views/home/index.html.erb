<!-- Navigation -->
<nav class="bg-white shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <svg class="h-8 w-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span class="ml-2 text-xl font-bold text-gray-900">SecureAuth</span>
      </div>
      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", root_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium transition duration-150" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium transition duration-150" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<div class="relative bg-gradient-to-br from-indigo-50 via-white to-purple-50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
    <div class="text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-900 tracking-tight">
        <span class="block">Secure Your Account with</span>
        <span class="block text-indigo-600">Two-Factor Authentication</span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
        Add an extra layer of security to your account. Protect your data with industry-standard two-factor authentication.
      </p>
      <% if user_signed_in? %>
        <div class="mt-10 max-w-2xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Welcome back, <%= current_user.name || current_user.email %>!</h2>
              <p class="mt-2 text-gray-600">Manage your account security settings</p>
            </div>

            <!-- 2FA Status Card -->
            <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl p-6 mb-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <div class="<%= current_user.otp_required_for_login ? 'bg-green-500' : 'bg-gray-400' %> rounded-full p-2">
                    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900">Two-Factor Authentication</p>
                    <p class="text-sm text-gray-600">
                      <% if current_user.otp_required_for_login %>
                        <span class="text-green-700 font-medium">Enabled</span> - Your account is protected
                      <% else %>
                        <span class="text-gray-700 font-medium">Disabled</span> - Enable for extra security
                      <% end %>
                    </p>
                  </div>
                </div>

                <% if current_user.otp_required_for_login %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-700">
                    Inactive
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% if current_user.otp_required_for_login %>
                <!-- Disable 2FA Button -->
                <button onclick="document.getElementById('disable2FAModal').classList.remove('hidden')"
                    class="flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-red-600 hover:bg-red-700 transition duration-150">
                  <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                  Disable 2FA
                </button>
              <% else %>
                <!-- Enable 2FA Button -->
                <%= link_to enable_two_factor_authentication_path,
                    data: { turbo_prefetch: false },
                    class: "flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition duration-150" do %>
                  <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  Enable 2FA
                <% end %>
              <% end %>

              <%= link_to edit_user_registration_path,
                          data: { turbo_prefetch: false },
                  class: "flex items-center justify-center px-6 py-3 border-2 border-indigo-600 text-base font-medium rounded-lg text-indigo-600 bg-white hover:bg-indigo-50 transition duration-150" do %>
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Edit Profile
              <% end %>
            </div>
          </div>
        </div>

        <!-- Disable 2FA Modal -->
        <% if current_user.otp_required_for_login %>
          <div id="disable2FAModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
            <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-lg bg-white">
              <div class="mt-3">
                <div class="flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mx-auto">
                  <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 text-center mt-5">Disable Two-Factor Authentication</h3>
                <p class="text-sm text-gray-500 text-center mt-2">
                  Enter your password to confirm. This will make your account less secure.
                </p>
                <%= form_with url: disable_two_factor_authentication_path, method: :delete, class: "mt-4" do |f| %>
                  <div>
                    <%= f.password_field :password, placeholder: "Enter your password",
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent",
                        required: true %>
                  </div>
                  <div class="flex gap-2 mt-4">
                    <button type="button"
                        onclick="document.getElementById('disable2FAModal').classList.add('hidden')"
                        class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-150">
                      Cancel
                    </button>
                    <%= f.submit "Disable 2FA",
                        class: "flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition duration-150 cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="mt-10 flex justify-center gap-4">
          <%= link_to "Get Started", new_user_registration_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-lg text-lg font-semibold shadow-lg hover:shadow-xl transition duration-150" %>
          <%= link_to "Learn More", "#features", class: "bg-white hover:bg-gray-50 text-indigo-600 px-8 py-3 rounded-lg text-lg font-semibold border-2 border-indigo-600 transition duration-150" %>
        </div>
      <% end %>
    </div>

    <!-- Hero Image/Illustration -->
    <div class="mt-16 flex justify-center">
      <div class="relative w-full max-w-3xl">
        <div class="bg-white rounded-2xl shadow-2xl p-8 border border-gray-100">
          <div class="flex items-center justify-center space-x-8">
            <div class="flex-1">
              <div class="bg-gradient-to-br from-indigo-100 to-purple-100 rounded-xl p-8 text-center">
                <svg class="h-24 w-24 mx-auto text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
                </svg>
                <p class="mt-4 text-sm font-semibold text-gray-700">Your Device</p>
              </div>
            </div>
            <div class="flex items-center justify-center">
              <svg class="h-8 w-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            <div class="flex-1">
              <div class="bg-gradient-to-br from-green-100 to-emerald-100 rounded-xl p-8 text-center">
                <svg class="h-24 w-24 mx-auto text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <p class="mt-4 text-sm font-semibold text-gray-700">Secure Access</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div id="features" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
        Why Choose Two-Factor Authentication?
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Protect your account with an additional layer of security
      </p>
    </div>

    <div class="mt-20 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Feature 1 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Enhanced Security</h3>
        <p class="mt-3 text-gray-600">
          Add an extra layer of protection beyond just your password. Even if your password is compromised, your account stays safe.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Quick Setup</h3>
        <p class="mt-3 text-gray-600">
          Get started in minutes. Simply scan a QR code with your authenticator app and you're protected.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Industry Standard</h3>
        <p class="mt-3 text-gray-600">
          Using TOTP (Time-based One-Time Password), the same technology trusted by major tech companies worldwide.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Mobile Friendly</h3>
        <p class="mt-3 text-gray-600">
          Works seamlessly with popular authenticator apps like Google Authenticator, Authy, and more.
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Backup Codes</h3>
        <p class="mt-3 text-gray-600">
          Never get locked out. Generate backup codes for emergency access when you can't use your device.
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="relative bg-gray-50 rounded-xl p-8 hover:shadow-xl transition duration-300">
        <div class="inline-flex items-center justify-center h-12 w-12 rounded-md bg-indigo-600 text-white">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Activity Monitoring</h3>
        <p class="mt-3 text-gray-600">
          Keep track of your login activity and receive alerts for any suspicious access attempts.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- How It Works Section -->
<div class="py-24 bg-gradient-to-br from-indigo-50 to-purple-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
        How It Works
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Get started with two-factor authentication in three simple steps
      </p>
    </div>

    <div class="mt-20">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
        <!-- Step 1 -->
        <div class="text-center">
          <div class="flex items-center justify-center">
            <div class="flex items-center justify-center h-16 w-16 rounded-full bg-indigo-600 text-white text-2xl font-bold">
              1
            </div>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-gray-900">Sign Up</h3>
          <p class="mt-3 text-gray-600">
            Create your account with your email and a strong password.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="text-center">
          <div class="flex items-center justify-center">
            <div class="flex items-center justify-center h-16 w-16 rounded-full bg-indigo-600 text-white text-2xl font-bold">
              2
            </div>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-gray-900">Enable 2FA</h3>
          <p class="mt-3 text-gray-600">
            Scan the QR code with your authenticator app to link your account.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="text-center">
          <div class="flex items-center justify-center">
            <div class="flex items-center justify-center h-16 w-16 rounded-full bg-indigo-600 text-white text-2xl font-bold">
              3
            </div>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-gray-900">Stay Protected</h3>
          <p class="mt-3 text-gray-600">
            Enter the code from your app each time you sign in for maximum security.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CTA Section -->
<div class="bg-indigo-600">
  <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">
        Ready to secure your account?
      </h2>
      <p class="mt-4 text-xl text-indigo-100">
        Join thousands of users who trust two-factor authentication to keep their accounts safe.
      </p>
      <div class="mt-8">
        <% if user_signed_in? %>
          <%= link_to "Go to Dashboard", root_path, class: "inline-block bg-white text-indigo-600 px-8 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition duration-150 shadow-lg" %>
        <% else %>
          <%= link_to "Get Started Now", new_user_registration_path, class: "inline-block bg-white text-indigo-600 px-8 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition duration-150 shadow-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Footer -->
<footer class="bg-gray-900">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <div class="flex items-center justify-center">
        <svg class="h-8 w-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span class="ml-2 text-xl font-bold text-white">SecureAuth</span>
      </div>
      <p class="mt-4 text-gray-400">
        Protecting your digital identity with industry-standard two-factor authentication.
      </p>
      <p class="mt-2 text-sm text-gray-500">
        &copy; <%= Time.current.year %> SecureAuth. All rights reserved.
      </p>
    </div>
  </div>
</footer>
